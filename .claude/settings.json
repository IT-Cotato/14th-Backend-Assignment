{
  "permissions": {
    "allow": [
      "Bash(./gradlew compileJava:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew test:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-git.sh"
          }
        ]
      }
    ]
  }
}
